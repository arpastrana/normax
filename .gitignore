# Figures, animations and anything else an experiment writes. Every one is
# reproducible from the script that made it, so none of them belong in history.
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.webp
*.pdf
*.mp4
artifacts/

# Descended answers, kept so that looking at a design again is a read rather
# than a rerun. Reproducible from the run description that names them.
designs/
data/

# Multi-start landings, logs and descent paths. All of it regenerates from a
# fixed seed against the run description that names it.
trajectories/

# Viewer state polyscope writes beside wherever it ran.
.polyscope.ini
imgui.ini
