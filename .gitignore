.venv
__pycache__/
*.py[cod]
*$py.class
venv
.eggs
.pytest_cache
.ruff_cache

# Compiled XLA programs, keyed by computation, so an experiment run twice pays
# for arithmetic alone. Reproducible and machine-specific.
.jax_cache/
*.egg-info
.DS_Store
dist
build
CLAUDE.md

# Figures, animations and anything else an experiment writes. Every one is
# reproducible from the script that made it, so none of them belong in history.
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.webp
*.pdf
*.mp4

# Everything an experiment writes, whatever its extension: figures and
# animations, the answer a run descended to, and under runlogs/ and
# trajectories/ the console logs, variant run descriptions and multi-start
# landings behind the reported numbers. All reproducible from the run
# description that names them, and the directory is kept so a clone can write.
figures/*
!figures/.gitkeep
data/*

# Accepted headline archives and provenance, named so exploratory runs stay out.
!data/accepted_results.json
!data/arch.npz
!data/arch_heights.npz
!data/arch_fixed.npz
!data/warren.npz
!data/warren_heights.npz
!data/warren_fixed.npz
!data/vierendeel.npz
!data/vierendeel_heights.npz
!data/vierendeel_fixed.npz
!data/gridshell.npz
!data/gridshell_heights.npz
!data/gridshell_fixed.npz

# Curated submission assets, committed by exception. The README and the two
# example guides embed these, so they have to be in history for the pages to
# render on the forge; every other figure a run writes stays ignored above.
# Listed one by one rather than by a pattern, so nothing joins them by accident.
!figures/normax_pipeline.png
!figures/problem_setup_landscape.png
!figures/problem_setup_gridshell.png
!figures/problem_setup_gridshell_plan.png
!figures/validation_pipeline.png
!figures/validation_code.png
!figures/validation_pynite.png
!figures/arch_designs.png
!figures/arch_heights_designs.png
!figures/arch_fixed_designs.png
!figures/warren_designs.png
!figures/warren_heights_designs.png
!figures/warren_fixed_designs.png
!figures/vierendeel_designs.png
!figures/vierendeel_heights_designs.png
!figures/vierendeel_fixed_designs.png
!figures/gridshell_designs.png
!figures/gridshell_heights_designs.png
!figures/gridshell_fixed_designs.png
!figures/arch_optimization_web.gif
!figures/arch_heights_optimization_web.gif
!figures/arch_fixed_optimization_web.gif
!figures/warren_optimization_web.gif
!figures/warren_heights_optimization_web.gif
!figures/warren_fixed_optimization_web.gif
!figures/vierendeel_optimization_web.gif
