.venv
__pycache__/
*.py[cod]
*$py.class
venv
.eggs
.pytest_cache
.ruff_cache

# Compiled XLA programs, keyed by computation, so an experiment run twice pays
# for arithmetic alone. Reproducible and machine-specific.
.jax_cache/
*.egg-info
.DS_Store
dist
build
CLAUDE.md

# Figures, animations and anything else an experiment writes. Every one is
# reproducible from the script that made it, so none of them belong in history.
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.webp
*.pdf
*.mp4

# Everything an experiment writes, whatever its extension: figures and
# animations, the answer a run descended to, and under runlogs/ and
# trajectories/ the console logs, variant run descriptions and multi-start
# landings behind the reported numbers. All reproducible from the run
# description that names them, and the directory is kept so a clone can write.
figures/*
!figures/.gitkeep
data/

# Curated submission assets, committed by exception. The README embeds these,
# so they have to be in history for the page to render on the forge; every
# other figure a run writes stays ignored above. Listed one by one rather than
# by a pattern, so nothing joins them by accident.
!figures/arch_designs.png
!figures/warren_designs.png
!figures/arch_optimization.png

# What a local Tesseract writes per run: its captured stdio and its metrics.
# The client redirects file descriptors into here on every crossing.
logs/

# Viewer state polyscope writes beside wherever it ran.
.polyscope.ini
imgui.ini
