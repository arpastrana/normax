.venv
__pycache__/
*.py[cod]
*$py.class
venv
.eggs
.pytest_cache
.ruff_cache

# Compiled XLA programs, keyed by computation, so an experiment run twice pays
# for arithmetic alone. Reproducible and machine-specific.
.jax_cache/
*.egg-info
.DS_Store
dist
build
uv.lock
CLAUDE.md

# Figures, animations and anything else an experiment writes. Every one is
# reproducible from the script that made it, so none of them belong in history.
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.webp
*.pdf
*.mp4

# Everything a run leaves behind: the answer it descended to, and under
# trajectories/, the multi-start landings, logs and descent paths behind the
# reported numbers. Reproducible from the run description that names it.
data/

# What a local Tesseract writes per run: its captured stdio and its metrics.
# The client redirects file descriptors into here on every crossing.
logs/

# Viewer state polyscope writes beside wherever it ran.
.polyscope.ini
imgui.ini
